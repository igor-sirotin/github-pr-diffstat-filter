{
  "manifest_version": 3,
  "name": "GitHub PR Diffstat Filter",
  "version": "0.1.0",
  "description": "Shows PR line counts without lockfiles and other paths you choose to ignore.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gh-pr-diffstat-filter@sirotin",
      "strict_min_version": "121.0"
    }
  }
}
